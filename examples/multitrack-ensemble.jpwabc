// 多轨 MIDI 总谱示例：钢琴两个声部 + 小提琴一个声部
.Title
Title = {多轨总谱示例}
SubTitle = {钢琴与小提琴}
Composer = {示例}
KeyAndMeters = {1=C,4/4}
Tempo = {96}
.Voice.钢琴.V1
1' 2' 3' 4' |[1'3'5']--- |5' 4' 3' 2' |1'--- |
3' 4' 5' 6' |[2'4'6']--- |5' 3' 2' 1' |1'--- |]
.Voice.钢琴.V2
1, 5, 1 5 |[1,3,5,]--- |4, 1 5, 1 |1,--- |
4, 1 4 1 |[2,4,6,]--- |5, 2 5 2 |1,--- |]
.Voice.小提琴.V1
5' 5' 6' 5' |3'--- |4' 4' 3' 2' |1'--- |
3' 3' 4' 5' |6'--- |5' 3' 2' 1' |1'--- |]
